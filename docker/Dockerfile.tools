FROM eclipse-temurin:21-jdk

ARG TLA_TOOLS_URL=https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar
ARG TLA_TOOLS_SHA256=ab323b79802aedc3203b3f9af37c6aca3ed43f4e0225b36f2aa77b26de46c05f

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -L --fail --silent --show-error "$TLA_TOOLS_URL" -o /opt/tla2tools.jar \
    && echo "$TLA_TOOLS_SHA256  /opt/tla2tools.jar" | sha256sum -c -
